# Offline (OR-LAB / production) environment template.
#
# install_offline.sh copies this to .env on first run and auto-fills
# PROJECT_NAME, APP_VERSION, MSSQL_SA_PASSWORD, SETTINGS_ENCRYPTION_KEY, and
# PASSWORD_EXPORT_ENCRYPTION_KEY automatically -- the operator does not need
# to touch this file for those. Only MSSQL_PID (a licensing decision) still
# requires manual input. Never commit the filled-in .env.

# ---- Project identity ----
PROJECT_NAME=pfms
# Auto-filled from the release's IMAGE_VERSION file -- always matches the
# version tag actually baked into docker-images/*.tar (see RELEASE_NOTES.md).
APP_VERSION=__SET_ME__

# ---- SQL Server ----
# Auto-filled with a fixed value by install_offline.sh -- see
# RELEASE_NOTES.md "Password handling" for why it's fixed rather than
# randomly generated.
MSSQL_SA_PASSWORD=__SET_ME__
# "Developer" edition is NOT licensed for production. Confirm the hospital's
# actual SQL Server licensing before deployment and set the matching edition:
# Express (free, limited) / Standard / Enterprise / EnterpriseCore. This is
# the one value install_offline.sh will stop and ask you to set -- it's a
# licensing decision, not something safe to auto-pick.
MSSQL_PID=__SET_ME__
DB_DATABASE=IncidentManager
# Per RAH's Database Standard, prefer sharing one SQL Server instance across
# apps when practical. If OR-LAB's existing SQL Server instance (already
# used by HCopilot on host port 1433) will host this database too, do not
# start a second sqlserver container from this compose file at all --
# remove the "sqlserver" and "db-init" services here and point
# DB_SERVER (backend env, not in this file -- see docker-compose.yml) at
# the existing shared instance instead. Decide this before first deployment.
SQLSERVER_HOST_PORT=1433

# ---- Application ports ----
# Reserved on OR-LAB (150.50.10.30) per the port snapshot doc: 8100
# (backend), 8101 (frontend HTTP, redirects to HTTPS), 8102 (frontend
# HTTPS -- the "spare" port, now used for this). Re-verify these are still
# free on OR-LAB itself (e.g. `ss -tulpn`) before deploying -- the snapshot
# doc has no date and is not a live guarantee.
BACKEND_HOST_PORT=8100
FRONTEND_HOST_PORT=8101
FRONTEND_HTTPS_PORT=8102

# ---- TLS certificate ----
# REQUIRED: the IP address (or hostname) clinical workstations will actually
# type into their browser to reach this server, e.g. 150.50.10.30. A
# self-signed certificate is generated for exactly this address on first
# install (see scripts/generate_certificate.sh) -- HTTPS is required, not
# optional, for the Speech-to-Text microphone feature to work in the
# browser. Re-run generate_certificate.sh by hand if this address ever
# changes after install (a cert for one address will not validate for
# another). This is a network-identity fact only the operator knows --
# not something safe to auto-detect or auto-pick.
SERVER_HOSTNAME_OR_IP=__SET_ME__

# ---- Settings encryption ----
# Auto-filled by install_offline.sh with a fresh, randomly-generated Fernet
# key, unique to this deployment. REQUIRED for the Hospital Directory API
# settings page to work (Config -> Hospital Directory API tab). If this key
# is ever lost or rotated, any previously-saved Hospital Directory API key
# becomes undecryptable (the app reports this clearly and lets an admin
# re-save it -- it does not crash), so treat it with the same care as a
# database password once generated.
SETTINGS_ENCRYPTION_KEY=__SET_ME__

# ---- Password export encryption ----
# Auto-filled by install_offline.sh with a fresh, randomly-generated Fernet
# key, unique to this deployment and different from SETTINGS_ENCRYPTION_KEY
# above. REQUIRED for Settings > Users Management's "export user
# credentials" feature to show real passwords instead of "[secured]". If
# lost or rotated, previously-exportable passwords become undecryptable
# (re-save via the export feature to fix).
PASSWORD_EXPORT_ENCRYPTION_KEY=__SET_ME__
