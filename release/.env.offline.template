# Offline (OR-LAB / production) environment template.
#
# Copy this to .env on the offline server, fill in real values, and never
# commit the filled-in copy. This file documents every value the operator
# must set -- it intentionally contains no real secrets.

# ---- Project identity ----
PROJECT_NAME=pfms
# Must match the version tag baked into the release's docker-images/*.tar
# (see release/docker-images/ and RELEASE_NOTES.md).
APP_VERSION=__SET_ME__

# ---- SQL Server ----
# REQUIRED: set a strong, unique password. Record it in the hospital's
# approved credential store, not in this file once filled in.
MSSQL_SA_PASSWORD=__SET_ME__
# "Developer" edition is NOT licensed for production. Confirm the hospital's
# actual SQL Server licensing before deployment and set the matching edition:
# Express (free, limited) / Standard / Enterprise / EnterpriseCore.
MSSQL_PID=__SET_ME__
DB_DATABASE=IncidentManager
# Per RAH's Database Standard, prefer sharing one SQL Server instance across
# apps when practical. If OR-LAB's existing SQL Server instance (already
# used by HCopilot on host port 1433) will host this database too, do not
# start a second sqlserver container from this compose file at all --
# remove the "sqlserver" and "db-init" services here and point
# DB_SERVER (backend env, not in this file -- see docker-compose.yml) at
# the existing shared instance instead. Decide this before first deployment.
SQLSERVER_HOST_PORT=1433

# ---- Application ports ----
# Reserved on OR-LAB (150.50.10.30) per the port snapshot doc: 8100
# (backend), 8101 (frontend), 8102 (spare, do not allocate yet). Re-verify
# these are still free on OR-LAB itself (e.g. `ss -tulpn`) before deploying --
# the snapshot doc has no date and is not a live guarantee.
BACKEND_HOST_PORT=8100
FRONTEND_HOST_PORT=8101

# ---- Settings encryption ----
# REQUIRED for the Hospital Directory API settings page to work (Config ->
# Hospital Directory API tab). Generate a real key on the offline server
# after loading the backend image:
#   docker run --rm rah-pfms-backend:1.0.0 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Record it in the hospital's approved credential store. If this key is ever
# lost or rotated, any previously-saved Hospital Directory API key becomes
# undecryptable (the app reports this clearly and lets an admin re-save it --
# it does not crash), so treat it with the same care as a database password.
SETTINGS_ENCRYPTION_KEY=__SET_ME__

# ---- Password export encryption ----
# REQUIRED for Settings > Users Management's "export user credentials"
# feature to show real passwords instead of "[secured]". Generate a
# DIFFERENT key than SETTINGS_ENCRYPTION_KEY above (same command):
#   docker run --rm rah-pfms-backend:1.0.0 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Record it in the hospital's approved credential store, with the same care
# as a database password -- if lost or rotated, previously-exportable
# passwords become undecryptable (re-save via the export feature to fix).
PASSWORD_EXPORT_ENCRYPTION_KEY=__SET_ME__
