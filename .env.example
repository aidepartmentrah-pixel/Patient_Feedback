# Copy this file to .env before running `docker compose up`.
# Never commit a real .env with real passwords -- .env is gitignored.

# ---- Project identity ----
PROJECT_NAME=pfms
APP_VERSION=1.0.0

# ---- SQL Server ----
# CHANGE THIS to a strong password before first run.
MSSQL_SA_PASSWORD=ChangeMe_Strong_Password_1!
# "Developer" is free but NOT licensed for production use -- see
# release/documentation/INSTALL_OFFLINE.md before deploying to OR-LAB.
# Valid values: Developer, Express, Standard, Enterprise, EnterpriseCore.
MSSQL_PID=Developer
DB_DATABASE=IncidentManager
SQLSERVER_HOST_PORT=1433

# ---- Application ports ----
# Reserved on OR-LAB per the port snapshot: 8100 (backend), 8101 (frontend),
# 8102 (spare). Keep these unless you have a reason to diverge locally.
BACKEND_HOST_PORT=8100
FRONTEND_HOST_PORT=8101

# ---- Settings encryption ----
# Required for saving Hospital Directory API settings (core/settings_encryption.py).
# Generate one with:
#   docker run --rm rah-pfms-backend:1.0.0 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/rotating this key makes any previously-saved API key undecryptable
# (the app reports this clearly and lets you re-save, it doesn't crash).
SETTINGS_ENCRYPTION_KEY=ChangeMe_Generate_A_Real_Fernet_Key

# ---- Frontend build-time API URL ----
# NOTE: this is NOT read by docker-compose. The frontend calls same-origin
# "/api/*" paths (see Front_End_Feedback_Analysis/src/api/apiClient.js) and
# nginx.conf proxies them to the backend container -- there is nothing to
# configure here at deploy time. REACT_APP_API_URL in the frontend repo's
# .env.production is only a fallback baked in at image build time.
